{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m unittest *)",
      "Bash(python -m pytest *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git rev-list *)",
      "Bash(git rev-parse *)",
      "Bash(git check-ignore *)"
    ]
  }
}
